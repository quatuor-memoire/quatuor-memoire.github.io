---

<BaseLayout title="Calendar">
  <div class="fixed top-0 left-0 right-0 w-screen z-40">
    <Navbar locale="en" page="calendar" />
  </div>
  <div class="relative overflow-x-hidden overflow-y-auto pt-24 h-screen">
    <div class="flex flex-col gap-4 justify-center items-center max-sm:mr-0">
      <div class="flex flex-col gap-1">
        <div
          class="text-5xl font-[LibreBaskerville] text-white mt-10 max-sm:px-4"
        >
          Upcoming Events
        </div>
        <div class="border-2 border-white h-1 w-sm"></div>
      </div>
      <div
        id="events"
        class="flex flex-col items-start justify-center gap-6 max-w-2xl mt-8 max-sm:px-4"
      >
        <div class="lds-ellipsis">
          <div></div><div></div><div></div><div></div>
        </div>
        <!-- {
          events.map((event) => (
            <Event
              date={event.date}
              info={event.info}
              address={event.address}
              tickets={event.tickets}
            />
          ))
        } -->
      </div>
    </div>
  </div>

  <script
    is:inline
    src="https://cdn.jsdelivr.net/npm/public-google-sheets-parser@latest"
  ></script>
  <script is:inline>
    (function () {
      let parser = new PublicGoogleSheetsParser(
        "1Exc7lnFY4W6HlVh4gV6Y4QI86j8HUssmIRyOjwzGCDo",
        { useFormat: true },
      );

      const eventsData = {
        events: [],
      };

      const retrieveDataPromises = [];

      // Extract Calendar EN
      parser.setOption({ sheetName: "Calendar EN" });
      retrieveDataPromises.push(
        parser.parse().then((data) => (eventsData.events = data)),
      );

      // Use 'astro:page-load' to support View Transitions
      document.addEventListener(
        "astro:page-load",
        function () {
          const eventsContainer = document.getElementById("events");
          if (!eventsContainer) return;

          Promise.allSettled(retrieveDataPromises).then((results) => {
            if (results.some((r) => r.status === "rejected")) {
              eventsContainer.innerHTML = `
              <p>&#128560; Error loading event data dynamically. See the schedule in the public Google Sheet</a>.</p>
            `;
              return;
            }

            // Remove all loading spinners
            document
              .querySelectorAll(".lds-ellipsis")
              .forEach((e) => e.remove());

            // Success processing sheet -- inject it into the HTML:
            // Clear container first to prevent duplicates on navigation
            eventsContainer.innerHTML = "";

            eventsData.events.forEach(function (event) {
              const eventHtml = `<div class="flex items-start justify-center gap-4">
              <div class="gradient-border relative rounded-xl">
                <div class="w-32 h-32 p-2 text-2xl text-center flex justify-center items-center text-white font-[EditorialNewRegular]">
                  ${event["Date"]}
                </div>
              </div>
              <div class="flex-1 text-xl text-white font-[BebasNeueProRegular] text-wrap flex flex-col items-start justify-center">
                <p>${event["Info"]}</p>
                <p>${event["Address"]}</p>
                <a href="${event["Tickets"]}" class="underline hover:text-blue-400" target="_blank">
                  tickets
                </a>
              </div>
          </div>`;
              eventsContainer.insertAdjacentHTML("beforeend", eventHtml);
            });
          });
        },
        ,
      );
    })();
  </script>
</BaseLayout>
