---
import BaseLayout from "../../layouts/BaseLayout.astro";
import Navbar from "../../components/Navbar.astro";
import Evenement from "../../components/Event.astro";
import PublicGoogleSheetsParser from "public-google-sheets-parser";

const parser = new PublicGoogleSheetsParser(
  "1Exc7lnFY4W6HlVh4gV6Y4QI86j8HUssmIRyOjwzGCDo",
  { sheetName: "Calendar FR", useFormat: true },
);

const response = await parser.parse();

type Event = {
  date: any;
  info: any;
  address: any;
  tickets: any;
};

let events: Event[] = [];

for (let entry of response) {
  let event = {
    date: entry["Date"],
    info: entry["Info"],
    address: entry["Address"],
    tickets: entry["Tickets"],
  };
  events.push(event);
}
---

<BaseLayout title="Calendar">
  <div class="fixed top-0 left-0 right-0 w-screen z-40">
    <Navbar locale="fr" page="calendar" />
  </div>
  <div class="relative overflow-x-hidden overflow-y-auto pt-24 h-screen">
    <div class="flex flex-col gap-4 justify-center items-center max-sm:mr-0">
      <div class="flex flex-col gap-1">
        <div
          class="text-5xl font-[LibreBaskerville] text-white mt-10 max-sm:px-4"
        >
          Événements à venir
        </div>
        <div class="border-2 border-white h-1 w-sm"></div>
      </div>
      <div
        class="flex flex-col items-start justify-center gap-6 max-w-2xl mt-8 max-sm:px-4"
      >
        {
          events.map((event) => (
            <Evenement
              date={event.date}
              info={event.info}
              address={event.address}
              tickets={event.tickets}
            />
          ))
        }
      </div>
    </div>
  </div>
</BaseLayout>
