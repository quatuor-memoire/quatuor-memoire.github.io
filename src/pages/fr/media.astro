---

<BaseLayout title="Media">
  <div class="fixed top-0 left-0 right-0 w-screen z-40">
    <Navbar page="media" locale="fr" />
  </div>
  <div class="relative overflow-x-hidden overflow-y-auto pt-24 h-screen">
    <img
      src={Quatuor_Memoire_Performance.src}
      alt=""
      class="fixed top-1/2 left-1/2 -translate-x-1/2 -translate-y-1/2
           h-[250vh] max-w-full object-contain opacity-20 pointer-events-none select-none z-1 overflow-hidden"
    />
    <div class="relative z-10">
      <div class="flex flex-col items-center justify-center gap-1">
        <div
          class="text-5xl font-[LibreBaskerville] text-white mt-10 max-sm:px-4"
        >
          Nos Performances
        </div>
        <div class="border-2 border-white h-1 w-sm"></div>
      </div>
      <div
        id="videos"
        class="flex flex-row flex-wrap gap-4 items-start justify-center mt-8 max-sm:px-4"
      >
        <!-- {
          videos.map((video) => (
            <iframe
              class="rounded-xl"
              width="560"
              height="315"
              src={video}
              title="YouTube video player"
              allowfullscreen
            />
          ))
        } -->
      </div>
    </div>
    <script
      is:inline
      src="https://cdn.jsdelivr.net/npm/public-google-sheets-parser@latest"
    ></script>
    <script is:inline>
      (function () {
        let parser = new PublicGoogleSheetsParser(
          "1Exc7lnFY4W6HlVh4gV6Y4QI86j8HUssmIRyOjwzGCDo",
          { useFormat: true },
        );

        const videosData = {
          videos: [],
        };

        const retrieveDataPromises = [];

        // Extract Media
        parser.setOption({ sheetName: "Media" });
        retrieveDataPromises.push(
          parser.parse().then((data) => (videosData.videos = data)),
        );

        // When the document loads, inject the event data from the Google Sheet:
        document.addEventListener(
          "astro:page-load",
          function () {
            Promise.allSettled(retrieveDataPromises).then((results) => {
              if (results.some((r) => r.status === "rejected")) {
                // Error retrieving the spreadsheet, default to just injecting the link directly:
                const container_div = document.getElementById("events");
                container_div.innerHTML = `
              <p>&#128560; Error loading event data dynamically. See the schedule in the public Google Sheet</a>.</p>
            `;
                return;
              }

              // Remove all loading spinners
              document
                .querySelectorAll(".lds-ellipsis")
                .forEach((e) => e.remove());

              // Success processing sheet --inject it into the HTML:
              const videosContainer = document.getElementById("videos");

              // Change 'videosData.events' to 'videosData.videos'
              videosData.videos.forEach(function (video) {
                const videoHtml = `<iframe
              class="rounded-xl"
              width="560"
              height="315"
              src="${video["Video"]}"
              title="YouTube video player"
              allow="accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture; web-share"
              allowfullscreen
            ></iframe>`;
                videosContainer.insertAdjacentHTML("beforeend", videoHtml);
              });
            });
          },
          { once: true },
        );
      })();
    </script>
  </div>
</BaseLayout>
