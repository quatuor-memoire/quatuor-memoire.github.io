---
import BaseLayout from "../../layouts/BaseLayout.astro";
import Navbar from "../../components/Navbar.astro";
import { Image } from "astro:assets";
import EB_Quator_Memoire_1 from "../../photos/EB_Quatuor_Memoire_1.jpg";
import EB_Quator_Memoire_2 from "../../photos/EB_Quatuor_Memoire_2.jpg";
import EB_Quator_Memoire_3 from "../../photos/EB_Quatuor_Memoire_3.jpg";
import EB_Quator_Memoire_5 from "../../photos/EB_Quatuor_Memoire_5.jpg";
import Portrait_Audreanne from "../../photos/Portrait_Audréanne.jpg";
import Portrait_Bailey from "../../photos/Portrait_Bailey.jpg";
import Portrait_Marilou from "../../photos/Portrait_Marilou.jpg";
import Portrait_Meggie from "../../photos/Portrait_Meggie.jpg";

import PublicGoogleSheetsParser from "public-google-sheets-parser";

const parser = new PublicGoogleSheetsParser(
	"1Exc7lnFY4W6HlVh4gV6Y4QI86j8HUssmIRyOjwzGCDo",
	{ sheetName: "About FR" },
);

let aboutData = {
	descriptions: [] as any[],
	bailey: [] as any[],
	marilou: [] as any[],
	meggie: [] as any[],
	audreanne: [] as any[],
};

const response = await parser.parse();

for (let entry of response) {
	aboutData.descriptions.push(entry["Description"]);
	aboutData.bailey.push(entry["Bailey"]);
	aboutData.marilou.push(entry["Marilou"]);
	aboutData.meggie.push(entry["Meggie"]);
	aboutData.audreanne.push(entry["Audreanne"]);
}
---

<BaseLayout title="Quatuor Mémoire">
	<div
		x-data="{ 
      fadeBg: false,
      showNavbar: false,
      scrollY: 0,
      smoothY: 0,
      init() {        
        const update = () => {
          this.smoothY += (this.scrollY - this.smoothY) * 0.1;
          requestAnimationFrame(update);
        };
        update();
      } 
    }"
		x-on:scroll.window="scrollY = window.scrollY; showNavbar = scrollY > window.innerHeight - 650"
		class="relative overflow-x-hidden overflow-y-auto transition-colors duration-1000"
	>
		<div
			class="fixed inset-0 bg-black transition-opacity duration-1000 pointer-events-none"
			:class="{ 'opacity-0': fadeBg, 'opacity-100': !fadeBg }"
		>
		</div>

		<div
			class="fixed top-0 left-0 w-screen min-h-[200vh] transition-opacity duration-1000 pointer-events-none will-change-transform"
			style="background: linear-gradient(to bottom left, #44403c, #78716c, #d6d3d1);"
			:class="{ 'opacity-100': fadeBg, 'opacity-0': !fadeBg }"
			:style="`transform: translateY(${smoothY * -0.1}px)`"
		>
		</div>

		<div
			class="fixed top-0 left-0 right-0 w-screen z-40 transition-transform duration-500 -translate-y-full"
			:class="showNavbar ? 'translate-y-0' : '-translate-y-full'"
		>
			<Navbar locale="fr" page="about" />
		</div>

		<section
			class="relative z-10 flex items-center justify-center min-h-screen w-full overflow-hidden"
			x-intersect:enter="fadeBg = false"
		>
			<h1
				class="absolute inset-0 flex items-center justify-center text-center text-white text-9xl text-shadow-white text-shadow-lg font-[NeueMachinaRegular] sm:text-8xl lg:text-9xl animate-fadeIn will-change-transform transition-transform duration-300 ease-out max-sm:text-5xl max-sm:text-wrap"
				:style="`transform: translateY(${smoothY * -0.05}px)`"
			>
				Quatuor Mémoire
			</h1>
		</section>

		<section
			class="relative z-10 flex justify-center items-center min-h-[50vh] w-full overflow-hidden"
			x-intersect="fadeBg = true"
			id="about"
		>
			<div
				class="flex flex-row gap-4 items-center justify-between max-sm:flex-col max-sm:gap-14"
			>
				<div class="flex flex-col gap-1">
					<div
						class="flex text-4xl justify-center items-center text-wrap w-[400px] text-white font-[NeueMachinaRegular]"
					>
						À propos du Quatuor Mémoire
					</div>
					<div class="border-2 border-white w-56 h-1"></div>
				</div>
				<div
					class="w-1/2 max-sm:w-full will-change-transform transition-transform duration-300 ease-out"
					:style="`transform: translateY(${smoothY * -0.01}px)`"
				>
					<Image
						src={EB_Quator_Memoire_1}
						alt="All members of the band at Entrepöt 77 in the Mile End, Montréal"
						class="rounded-xl shadow-lg w-full h-auto"
					/>
				</div>
				<div
					class="w-2/5 max-sm:w-full h-fit leading-relaxed will-change-transform transition-transform duration-300 ease-out"
					:style="`transform: translateY(${smoothY * -0.02}px)`"
				>
					<div
						class="text-2xl text-white text-right font-[BebasNeueProRegular] max-sm:text-center max-sm:w-full max-sm:h-fit"
					>
						<p>{aboutData.descriptions[0]}</p>
					</div>
				</div>
			</div>
		</section>
		<section
			class="relative z-10 flex justify-center items-center min-h-[50vh] w-full overflow-hidden"
			x-intersect="fadeBg = true"
		>
			<div
				class="flex flex-row gap-10 items-center justify-between max-sm:flex-col-reverse max-sm:gap-14"
			>
				<div
					class="w-2/5 max-sm:w-full leading-relaxed will-change-transform transition-transform duration-300 ease-out"
					:style="`transform: translateY(${smoothY * -0.02}px)`"
				>
					<div
						class="text-2xl text-white text-left max-sm:text-center max-sm:h-fit font-[BebasNeueProRegular]"
					>
						<p>{aboutData.descriptions[1]}</p>
					</div>
				</div>
				<div
					class="w-1/2 max-sm:w-full will-change-transform transition-transform duration-300 ease-out"
					:style="`transform: translateY(${smoothY * -0.01}px)`"
				>
					<Image
						src={EB_Quator_Memoire_3}
						alt="All members of the band posing in front of a picnic table."
						class="rounded-xl shadow-lg w-full h-auto"
					/>
				</div>
			</div>
		</section>
		<section
			class="relative z-10 flex justify-center items-center min-h-[50vh] w-full overflow-hidden"
			x-intersect="fadeBg = true"
		>
			<div
				class="flex flex-row gap-10 items-center justify-between max-sm:flex-col max-sm:gap-14"
			>
				<div
					class="w-1/2 max-sm:w-full will-change-transform transition-transform duration-300 ease-out"
					:style="`transform: translateY(${smoothY * -0.01}px)`"
				>
					<Image
						src={EB_Quator_Memoire_2}
						alt="All members of the band sitting on a concrete bench."
						class="rounded-xl shadow-lg w-full h-auto"
					/>
				</div>

				<div
					class="w-2/5 max-sm:w-full leading-relaxed will-change-transform transition-transform duration-300 ease-out"
					:style="`transform: translateY(${smoothY * -0.02}px)`"
				>
					<div
						class="text-2xl text-white text-right max-sm:text-center max-sm:h-fit font-[BebasNeueProRegular]"
					>
						<p>{aboutData.descriptions[2]}</p>
					</div>
				</div>
			</div>
		</section>

		<section
			class="relative z-10 flex justify-center items-center min-h-[50vh] w-full overflow-hidden"
			x-intersect="fadeBg = true"
		>
			<div
				class="flex flex-row gap-10 items-center justify-between max-sm:flex-col-reverse max-sm:gap-14"
			>
				<div
					class="w-2/5 max-sm:w-full leading-relaxed will-change-transform transition-transform duration-300 ease-out"
					:style="`transform: translateY(${smoothY * -0.02}px)`"
				>
					<div
						class="text-2xl text-white text-left max-sm:text-center max-sm:h-fit font-[BebasNeueProRegular]"
					>
						<p>{aboutData.descriptions[3]}</p>
					</div>
				</div>

				<div
					class="w-1/2 max-sm:w-full will-change-transform transition-transform duration-300 ease-out"
					:style="`transform: translateY(${smoothY * -0.01}px)`"
				>
					<Image
						src={EB_Quator_Memoire_5}
						alt="Photo of all members of the band posing in front of a building."
						class="rounded-lg shadow-lg w-full h-auto"
					/>
				</div>
			</div>
		</section>
		<section
			class="relative z-10 w-full py-20 overflow-x-auto flex justify-center items-center gap-2"
		>
			<div class="flex flex-col gap-1">
				<div
					class="flex text-4xl font-[NeueMachinaRegular] justify-center items-center text-white"
				>
					L'Ensemble
				</div>
				<div class="border-2 border-white w-full h-1"></div>
			</div>
			<div class="flex space-x-6">
				<div
					x-data="{ open: false }"
					class="relative w-96 h-auto cursor-pointer overflow-hidden rounded-lg shadow-lg max-sm:w-screen"
					@click="open = !open"
				>
					<Image
						src={Portrait_Bailey}
						alt="Bailey Wantuch"
						class="w-full h-full object-cover transition-transform duration-300"
						:class="{ 'scale-110': open }"
					/>

					<div
						class="absolute inset-0 bg-black transition-opacity duration-300 flex items-center justify-center p-4"
						:class="{ 'opacity-80': open, 'opacity-0 pointer-events-none': !open }"
					>
						<div
							class="text-white text-base font-[EditorialNewRegular] overflow-y-auto max-h-full text-center"
						>
							{
								aboutData.bailey.map((line) => (
									<>
										<p>{line}</p>
										<br />
									</>
								))
							}
						</div>
					</div>
				</div>
				<div
					class="absolute left-16 bottom-12 max-sm:-left-132 text-white font-[BebasNeueProRegular] text-xl whitespace-nowrap pointer-events-none"
				>
					<span class="pointer-events-auto">&copy; Emmanuel Bernier</span>
				</div>
				<div
					x-data="{ open: false }"
					class="relative w-96 h-auto cursor-pointer overflow-hidden rounded-lg shadow-lg"
					@click="open = !open"
				>
					<Image
						src={Portrait_Marilou}
						alt="Marilou Lepage"
						class="w-full h-full object-cover transition-transform duration-300"
						:class="{ 'scale-110': open }"
					/>

					<div
						class="absolute inset-0 bg-black transition-opacity duration-300 flex items-center justify-center p-4"
						:class="{ 'opacity-80': open, 'opacity-0 pointer-events-none': !open }"
					>
						<div
							class="text-white text-base font-[EditorialNewRegular] overflow-y-auto max-h-full text-center"
						>
							{
								aboutData.marilou.map((line) => (
									<>
										<p>{line}</p>
										<br />
									</>
								))
							}
						</div>
					</div>
				</div>
				<div
					x-data="{ open: false }"
					class="relative w-96 h-auto cursor-pointer overflow-hidden rounded-lg shadow-lg"
					@click="open = !open"
				>
					<Image
						src={Portrait_Meggie}
						alt="Meggie Lacombe"
						class="w-full h-full object-cover transition-transform duration-300"
						:class="{ 'scale-110': open }"
					/>

					<div
						class="absolute inset-0 bg-black transition-opacity duration-300 flex items-center justify-center p-4"
						:class="{ 'opacity-80': open, 'opacity-0 pointer-events-none': !open }"
					>
						<div
							class="text-white text-base font-[EditorialNewRegular] overflow-y-auto max-h-full text-center"
						>
							{
								aboutData.meggie.map((line) => (
									<>
										<p>{line}</p>
										<br />
									</>
								))
							}
						</div>
					</div>
				</div>
				<div
					x-data="{ open: false }"
					class="relative w-96 h-auto cursor-pointer overflow-hidden rounded-lg shadow-lg"
					@click="open = !open"
				>
					<Image
						src={Portrait_Audreanne}
						alt="Audréanne Filion"
						class="w-full h-full object-cover transition-transform duration-300"
						:class="{ 'scale-110': open }"
					/>

					<div
						class="absolute inset-0 bg-black transition-opacity duration-300 flex items-center justify-center p-4"
						:class="{ 'opacity-80': open, 'opacity-0 pointer-events-none': !open }"
					>
						<div
							class="text-white text-base font-[EditorialNewRegular] overflow-y-auto max-h-full text-center"
						>
							{
								aboutData.audreanne.map((line) => (
									<>
										<p>{line}</p>
										<br />
									</>
								))
							}
						</div>
					</div>
				</div>
			</div>
		</section>
	</div>
</BaseLayout>
