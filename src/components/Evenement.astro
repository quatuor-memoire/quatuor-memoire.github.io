---
let { date, info, address, tickets } = Astro.props;
---

<div class="flex justify-center gap-4">
  {
    date && (
      <div class="gradient-border relative rounded-xl">
        <div class="w-40 h-40 p-2 text-2xl text-center flex flex-col justify-center items-center text-white font-[EditorialNewRegular]">
          {date}
        </div>
      </div>
    )
  }
  <div
    class="flex-1 text-xl text-white font-[BebasNeueProRegular] flex flex-col justify-center items-start"
  >
    <p style="white-space: pre-line;" class="text-left">{info}</p>

    {address && <p class="text-left">{address}</p>}
    {
      tickets && (
        <a
          href={tickets}
          class="underline hover:text-blue-400 text-left"
          target="_blank"
        >
          tickets
        </a>
      )
    }
  </div>
</div>
